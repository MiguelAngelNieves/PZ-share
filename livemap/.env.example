# Token que usa PZ Share para mandar posiciones (genera uno: openssl rand -hex 24)
PZMAP_TOKEN=cambia-esto
# Llave para ver el mapa (vacía = cualquiera con el link). Se usa como ?k=LLAVE
PZMAP_VIEW_KEY=
PZMAP_TITLE=PZ2026 · Mapa en vivo
# Opcional: plantilla de tiles propia (Leaflet), p. ej. https://.../{z}/{x}/{y}.png
PZMAP_TILES=
# Opcional: imagen del mapa en data/map.png y sus límites en tiles del juego: x0,y0,x1,y1
PZMAP_IMAGE_BOUNDS=
# Opcional: avisos en un canal de Discord (Ajustes del canal > Integraciones > Webhooks > Copiar URL)
PZMAP_DISCORD_WEBHOOK=
